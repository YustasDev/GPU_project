# 1. Берём официальный лёгкий образ Python 3.11.
#    Суффикс -slim означает урезанную версию без лишних системных пакетов.
FROM python:3.11-slim

# 2. Настраиваем переменные окружения для Python.
#    PYTHONDONTWRITEBYTECODE=1 — не создавать кэш-файлы .pyc (в контейнере они не нужны).
#    PYTHONUNBUFFERED=1        — не буферизовать вывод, чтобы логи шли в docker logs сразу,
#                                а не «пачками» после накопления буфера.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 3. Устанавливаем системные зависимости.
#    OpenCV требует системную библиотеку libGL (пакет libgl1) и libglib2.0-0.
#    Без них при импорте cv2 контейнер упадёт с ошибкой "libGL.so.1: cannot open...".
#    В конце чистим кэш apt (rm -rf), чтобы не раздувать слой образа.
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 4. Устанавливаем быстрый пакетный менеджер uv (он на порядок быстрее pip).
RUN pip install --no-cache-dir uv

# 5. Создаём рабочую папку внутри контейнера. Дальше все пути — относительно /app.
WORKDIR /app

# 6. Кэширование зависимостей (Best Practice).
#    Сначала копируем ТОЛЬКО requirements.txt, а не весь проект. Тогда тяжёлый шаг
#    установки библиотек будет пересобираться лишь при изменении зависимостей,
#    а не каждый раз, когда вы поправили одну строчку в своём коде.
COPY requirements.txt .

# Ставим библиотеки через uv (все версии закреплены в requirements.txt).
#   --extra-index-url добавляет индекс PyTorch со сборками torch/torchvision под
#     CUDA 12.1 (метка +cu121); обычные пакеты по-прежнему берутся с PyPI.
#   --index-strategy unsafe-best-match — чтобы uv искал версии по ВСЕМ индексам
#     (иначе он остановится на PyPI и не найдёт сборку +cu121).
#   --system — ставим в системный Python (мы уже внутри изоляции контейнера).
#   --no-cache — не оставлять кэш загрузок в слое, чтобы образ был меньше.
RUN uv pip install --system --no-cache -r requirements.txt \
    --extra-index-url https://download.pytorch.org/whl/cu121 \
    --index-strategy unsafe-best-match

# 7. И только теперь копируем весь остальной код проекта.
#    Этот слой меняется часто, поэтому он идёт ПОСЛЕ установки зависимостей.
COPY . .

# Инструкцию CMD здесь НЕ пишем: одну и ту же сборку мы запустим двумя разными
# командами, а команду для каждого контейнера зададим в docker-compose.yml.
