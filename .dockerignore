# .dockerignore — что НЕ копировать в образ на шаге COPY . .

# Служебное и окружение
.git
.venv/
# Префикс **/ здесь обязателен. В .gitignore шаблон без него ловит файл на любой
# глубине, а в .dockerignore он привязан к КОРНЮ контекста — и тогда правило
# пропустит core/__pycache__/, db/__pycache__/ и прочие вложенные каталоги.
**/__pycache__/
**/*.pyc
.idea/
.pytest_cache/

# Данные и логи — создаются в рантайме, в образе не нужны
data/
logs/
runs/

# Секреты НЕ «запекаем» в образ — они придут через env_file в рантайме
.env

# Тяжёлые артефакты, не нужные для сборки
*.mp4
*.avi
yolo11*.pt
yolo26*.pt
best.pt.kaggle-trained

# черновики, документация и т.д.
*.txt
!requirements.txt
docs/
