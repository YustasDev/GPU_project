# .env.example — шаблон переменных окружения.
# Скопируйте его в .env и подставьте свои значения:  cp .env.example .env
# Файл .env в репозиторий НЕ коммитится: в нём лежат ваши секреты.

# Учётные данные Postgres. Их подставляет docker-compose.yml, когда создаёт контейнер БД.
# ВАЖНО: эти значения должны совпадать со строкой подключения в db/database.py,
# иначе приложение не сможет войти в базу.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase

# Ключ RouterAI для LLM-анализатора (core/analyzer.py и тест-скрипт gemma4_vision.py).
# Без него конвейер работает, но описания к событиям не создаются — шаг просто пропускается.
ROUTER_API_KEY=ВАШ_КЛЮЧ_ЗДЕСЬ
