# .env.example — шаблон переменных окружения.
# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Файл .env в репозиторий НЕ коммитится (он в .gitignore).

POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secret_password
POSTGRES_DB=observer_db

# Строка подключения приложения к базе.
# ВАЖНО: хост "db" (имя сервиса в docker-compose.yml), а не localhost.
# Логин/пароль/имя базы должны совпадать со значениями выше.
DATABASE_URL=postgresql+psycopg2://admin:your_secret_password@db:5432/observer_db

# Ключ OpenRouter для core/analyzer.py: вставьте его сразу после знака = (без пробелов и кавычек).
# Пока значение пустое, пайплайн работает, но описания к событиям не создаются.
OPENROUTER_API_KEY=

# Необязательные ключи — нужны только тестовым скриптам из корня репозитория.
# gemma4_vision.py (RouterAI, глава 11):
ROUTER_API_KEY=
# check_ollama_cloud.py, прямой путь в облако Ollama (ollama.com → Settings → API keys):
OLLAMA_API_KEY=
# check_alice_cloud.py (Yandex Cloud, API-ключ сервисного аккаунта):
YANDEX_API_KEY=
